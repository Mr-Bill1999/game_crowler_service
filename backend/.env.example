# Local run against the dockerized postgres/redis
GA_DATABASE_URL=postgresql+asyncpg://ga:ga@localhost:5432/gameanalytics
GA_REDIS_URL=redis://localhost:6379/0
GA_RATE_LIMIT_RPS=3
GA_BOOTSTRAP_DAYS=30
GA_LLM_PROVIDER=none
GA_LLM_MODEL=gemini-3.5-flash-lite
GA_LLM_THINKING_LEVEL=minimal
# Secrets: Google AI Studio key (Gemini) and YouTube Data API v3 key. Never commit real values.
GA_GEMINI_API_KEY=
GA_YOUTUBE_API_KEY=
