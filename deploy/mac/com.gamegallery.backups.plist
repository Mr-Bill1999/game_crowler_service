<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: deploy/deploy.sh install-mac-pull fills in REPO and installs it into ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gamegallery.backups</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>REPO/deploy/pull-backups.sh</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>HOME/GameGallery-backups/pull.log</string>
  <key>StandardErrorPath</key><string>HOME/GameGallery-backups/pull.log</string>
</dict>
</plist>
